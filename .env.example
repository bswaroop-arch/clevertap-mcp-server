# CleverTap credentials — get from Settings → Project page on the dashboard.
CLEVERTAP_ACCOUNT_ID=YOUR-ACCOUNT-ID
CLEVERTAP_PASSCODE=YOUR-PASSCODE

# Region subdomain. Options: in1 (India), eu1 (Europe), us1 (US),
# sg1 (Singapore), sk1 (Indonesia), aps3 (Mumbai), mec1 (Middle East).
CLEVERTAP_REGION=in1

# Optional: required only for the v2 External Trigger (multi-campaign bulk) API.
CLEVERTAP_TOKEN=

# Absolute path to the event schema CSV. Server parses this at startup to
# validate event + property names used in campaigns and data extraction.
# Export from CleverTap dashboard: Settings → Event Management → Export.
CLEVERTAP_EVENTS_SCHEMA_CSV=/absolute/path/to/events_schema.csv

# Optional: per-request timeout in milliseconds for calls to CleverTap.
# Default: 30000 (30s). Increase for large exports.
CLEVERTAP_TIMEOUT_MS=30000
